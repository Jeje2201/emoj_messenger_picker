{
  "manifest_version": 3,
  "name": "Messenger Emoji",
  "version": "1.0.0",
  "description": "Des raccourcis emoji personnalisables, uniquement sur Messenger Web.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Messenger Emoji",
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.messenger.com/*"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}